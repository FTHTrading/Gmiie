# ═══════════════════════════════════════════════════════════════
# XXXIII.IO ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# ─── Database ───
DATABASE_URL="postgresql://postgres:password@localhost:5433/xxxiii_dev?schema=public"
REDIS_URL="redis://localhost:6379"

# ─── AI / LLM ───
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"
AI_DEFAULT_MODEL="gpt-4o"
AI_FALLBACK_MODEL="gpt-4o-mini"
AI_TEMPERATURE="0.3"
AI_MAX_TOKENS="4000"

# ─── Pipeline Thresholds ───
DRAFT_SCORE_THRESHOLD="5.0"
AUTO_PUBLISH="true"

# ─── Ingestion Service ───
INGESTION_SERVICE_URL="http://localhost:8100"
INGESTION_DATABASE_URL="postgresql://postgres:password@localhost:5433/xxxiii_dev"
INGESTION_REDIS_URL="redis://localhost:6379/0"
INGESTION_RSS_POLL_INTERVAL="900"
INGESTION_SCRAPE_INTERVAL="3600"
INGESTION_API_POLL_INTERVAL="1800"
INGESTION_LOG_LEVEL="INFO"
INGESTION_TRANSLATE_TO_ENGLISH="true"
INGESTION_TRANSLATION_CHUNK_SIZE="3000"
INGESTION_TRANSLATION_MAX_CHARS="12000"

# ─── Publishing / Revalidation ───
REVALIDATE_ENDPOINTS="https://xxxiii.io/api/revalidate,https://news.unykorn.org/api/revalidate"
REVALIDATION_TOKEN="replace-with-shared-revalidate-token"

# ─── Digest Scheduling ───
NEWSLETTER_DIGEST_CADENCE="twice_daily" # daily | twice_daily
NEWSLETTER_DAILY_WINDOWS_UTC="6,18"

# ─── SMTP Delivery (Zoho compatible) ───
NEWSLETTER_SMTP_HOST="smtp.zoho.com"
NEWSLETTER_SMTP_PORT="587"
NEWSLETTER_SMTP_SECURE="false"
NEWSLETTER_SMTP_USER="insights@xxxiii.io"
NEWSLETTER_SMTP_PASS="replace-with-zoho-app-password"
NEWSLETTER_FROM="XXXIII Intelligence <insights@xxxiii.io>"

# ─── Auth ───
NEXTAUTH_SECRET="generate-a-secure-secret"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@xxxiii.io"

# ─── Domain Config ───
ROOT_DOMAIN="xxxiii.io"
SITE_URL="https://gmiie.xxxiii.io"
NEXT_PUBLIC_SITE_URL="https://gmiie.xxxiii.io"
GMIIE_DOMAIN="gmiie.xxxiii.io"
LPS_DOMAIN="lps.xxxiii.io"
STUDIO_DOMAIN="studio.xxxiii.io"
API_DOMAIN="api.xxxiii.io"

# ─── Deployment ───
NODE_ENV="development"

# ─── Queue ───
QUEUE_CONCURRENCY=3
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_MS=5000

# ─── Logging ───
LOG_LEVEL="info"
