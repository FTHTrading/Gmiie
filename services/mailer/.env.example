# GMIIE Mailer — Environment Variables
# Copy to .env and fill in before running

# Service port (default 9100)
MAILER_PORT=9100

# SMTP — works with any provider: SendGrid, Postmark, AWS SES, Mailgun, or self-hosted
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.your-sendgrid-api-key
SMTP_FROM_NAME=GMIIE Intelligence
SMTP_FROM_EMAIL=alerts@gmiie.xxxiii.io

# Owner email — ALWAYS receives a copy of every dispatch
OWNER_EMAIL=kevan@fthtrade.com

# GMIIE Next.js app — used to fetch subscriber lists
GMIIE_API_URL=http://localhost:3000
GMIIE_API_KEY=

# Branding
PLATFORM_NAME=GMIIE
PLATFORM_URL=https://gmiie.xxxiii.io

# Minimum article importance score to trigger alert emails (0–10)
ALERT_SCORE_THRESHOLD=7.0

# Logging
RUST_LOG=gmiie_mailer=info,tower_http=warn
